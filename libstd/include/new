#pragma once

#include <etl/freestore.h>

// The replaceable allocation functions must not be inline ([replacement.functions]), yet every
// translation unit including this header defines them. They are weak instead: the linker keeps
// one copy, and a program can still replace them with its own (strong) definitions.

/// Allocates requested number of bytes.
/// @param[in] size number of bytes to allocate
/// @return pointer to allocated memory
[[gnu::weak]] void* operator new(ETLSTD::size_t size) {
  return etl::FreeStore::Allocate(size);
}

/// Allocates requested number of bytes.
/// @param[in] size number of bytes to allocate
/// @return pointer to allocated memory
[[gnu::weak]] void* operator new[](ETLSTD::size_t size) {
  return etl::FreeStore::Allocate(size);
}

/// Deallocates memory space previously allocated by a matching operator new.
/// @param[in] ptr pointer to the memory to deallocate, or nullptr
[[gnu::weak]] void operator delete(void* ptr) noexcept {
  if (ptr != nullptr) {
    etl::FreeStore::Deallocate(ptr);
  }
}

/// Deallocates memory space previously allocated by a matching operator new[].
/// @param[in] ptr pointer to the memory to deallocate, or nullptr
[[gnu::weak]] void operator delete[](void* ptr) noexcept {
  operator delete(ptr);
}

/// Sized deallocation, called by delete-expressions on complete types (C++14).
/// @param[in] ptr pointer to the memory to deallocate, or nullptr
[[gnu::weak]] void operator delete(void* ptr, ETLSTD::size_t) noexcept {
  operator delete(ptr);
}

/// Sized deallocation, called by delete[]-expressions on complete types (C++14).
/// @param[in] ptr pointer to the memory to deallocate, or nullptr
[[gnu::weak]] void operator delete[](void* ptr, ETLSTD::size_t) noexcept {
  operator delete(ptr);
}

/// Placement new for allocating the object inside a given memory buffer.
/// These forms are not replaceable ([new.delete.placement]), so they can be inline.
/// @param[in] buf pointer to a memory area to initialize the object at
[[nodiscard]] inline void* operator new(ETLSTD::size_t, void* buf) noexcept {
  return buf;
}
[[nodiscard]] inline void* operator new[](ETLSTD::size_t, void* buf) noexcept {
  return buf;
}

/// Placement delete called automatically on "placement new" failure.
inline void operator delete(void*, void*) noexcept { }
inline void operator delete[](void*, void*) noexcept { }
