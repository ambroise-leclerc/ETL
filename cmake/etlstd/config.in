#pragma once

#define __ETL_HAS_EXCEPTIONS @ETL_PROFILE_EXCEPTIONS@
#define __ETL_HAS_RTTI @ETL_PROFILE_RTTI@

#if defined(__EXCEPTIONS) != __ETL_HAS_EXCEPTIONS
#error "ETLStd profile conflicts with the compiler exception flags"
#endif
#if defined(__GXX_RTTI) != __ETL_HAS_RTTI
#error "ETLStd profile conflicts with the compiler RTTI flags"
#endif

extern "C" const unsigned char __etl_profile_@ETL_PROFILE@;
// Retained by profile.ld in a non-allocated INFO section, with no startup calls or flash/SRAM cost.
[[gnu::used, gnu::section(".etl.profile.refs")]] static const unsigned char* const __etl_profile_reference =
    &__etl_profile_@ETL_PROFILE@;
