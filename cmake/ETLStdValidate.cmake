# Resolve literal target/alias dependencies through their compile usage requirements. Link-only
# dependencies and arbitrary conditional generator expressions are left to __etl/config guards.
function(etlstd_collect_profiles target property visited output)
    if (target IN_LIST visited)
        set(${output} "" PARENT_SCOPE)
        return()
    endif()
    list(APPEND visited "${target}")
    get_target_property(alias ${target} ALIASED_TARGET)
    if (alias)
        set(target "${alias}")
    endif()
    if (target STREQUAL "ETL::StdMinimal" OR target STREQUAL "etlstd_minimal")
        set(profiles minimal)
    elseif (target STREQUAL "ETL::StdFull" OR target STREQUAL "etlstd_full")
        set(profiles full)
    else()
        set(profiles "")
    endif()
    get_target_property(links ${target} ${property})
    foreach(link IN LISTS links)
        if (TARGET "${link}")
            etlstd_collect_profiles("${link}" INTERFACE_LINK_LIBRARIES "${visited}" inherited)
            list(APPEND profiles ${inherited})
        endif()
    endforeach()
    list(REMOVE_DUPLICATES profiles)
    set(${output} "${profiles}" PARENT_SCOPE)
endfunction()

# CMake normally puts transitive profile options last, silently overriding explicit user flags.
# Check the direct and transitive profile selection before compilation as defense in depth.
function(etlstd_validate_directory directory)
    get_property(targets DIRECTORY "${directory}" PROPERTY BUILDSYSTEM_TARGETS)
    foreach(target IN LISTS targets)
        etlstd_collect_profiles("${target}" LINK_LIBRARIES "" profiles)
        get_target_property(options ${target} COMPILE_OPTIONS)
        get_directory_property(global_flags DIRECTORY "${directory}" DEFINITION CMAKE_CXX_FLAGS)
        set(flags "${global_flags};${options}")
        foreach(config DEBUG RELEASE RELWITHDEBINFO MINSIZEREL)
            get_directory_property(config_flags DIRECTORY "${directory}" DEFINITION CMAKE_CXX_FLAGS_${config})
            string(APPEND flags ";${config_flags}")
        endforeach()
        if ("minimal" IN_LIST profiles)
            if (flags MATCHES "(^|[ ;])(-fexceptions|-frtti)($|[ ;])")
                message(FATAL_ERROR "ETLStd profile conflicts with the compiler flags on ${target}: minimal requires -fno-exceptions -fno-rtti.")
            endif()
        endif()
        if ("full" IN_LIST profiles)
            if (flags MATCHES "(^|[ ;])(-fno-exceptions|-fno-rtti)($|[ ;])")
                message(FATAL_ERROR "ETLStd profile conflicts with the compiler flags on ${target}: full requires -fexceptions -frtti.")
            endif()
        endif()
    endforeach()
    get_property(children DIRECTORY "${directory}" PROPERTY SUBDIRECTORIES)
    foreach(child IN LISTS children)
        etlstd_validate_directory("${child}")
    endforeach()
endfunction()
cmake_language(DEFER DIRECTORY "${CMAKE_SOURCE_DIR}" CALL etlstd_validate_directory "${CMAKE_SOURCE_DIR}")
