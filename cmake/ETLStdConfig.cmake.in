@PACKAGE_INIT@

if (NOT CMAKE_SYSTEM_PROCESSOR STREQUAL "avr" OR NOT CMAKE_CXX_COMPILER_ID STREQUAL "GNU")
    message(FATAL_ERROR "ETLStd requires AVR GCC; configure with an AVR toolchain file.")
endif()
if (CMAKE_CXX_COMPILER_VERSION VERSION_LESS 14.2)
    message(FATAL_ERROR "ETLStd requires AVR GCC 14.2 or newer for C++23 and -nostdlib++.")
endif()
if (NOT DEFINED ETL_AVR_MCU OR ETL_AVR_MCU STREQUAL "")
    message(FATAL_ERROR "ETLStd requires ETL_AVR_MCU to select the runtime multilib.")
endif()
execute_process(COMMAND "${CMAKE_CXX_COMPILER}" "-mmcu=${ETL_AVR_MCU}" -print-multi-directory
                RESULT_VARIABLE result OUTPUT_VARIABLE multilib OUTPUT_STRIP_TRAILING_WHITESPACE)
if (NOT result EQUAL 0 OR NOT multilib STREQUAL "@ETLSTD_MULTILIB@")
    message(FATAL_ERROR "ETLStd has no runtime for MCU ${ETL_AVR_MCU} (multilib '${multilib}'); rebuild/install ETLStd for this MCU.")
endif()
include("${CMAKE_CURRENT_LIST_DIR}/ETLStdTargets.cmake")
# Install-tree exports already verify their files. Build-tree exports do not, so only they need
# an explicit configure-time diagnostic when the runtime has not been built yet.
if (@ETLSTD_BUILD_TREE@)
    foreach(profile Minimal Full)
        get_target_property(configs ETL::Std${profile} IMPORTED_CONFIGURATIONS)
        foreach(config IN LISTS configs)
            get_target_property(archive ETL::Std${profile} IMPORTED_LOCATION_${config})
            if (NOT EXISTS "${archive}")
                message(FATAL_ERROR "ETLStd runtime archive is missing: ${archive}; build ETLStd first.")
            endif()
        endforeach()
    endforeach()
endif()
include("${CMAKE_CURRENT_LIST_DIR}/ETLStdValidate.cmake")
check_required_components(ETLStd)
